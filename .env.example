# ===========================================================================
# Casa AI - configuracion. Copia a .env y rellena. NO subas .env a git.
# ===========================================================================

# --- Claude ----------------------------------------------------------------
# Alternativa: no pongas nada aqui y usa `ant auth login` (perfil OAuth).
ANTHROPIC_API_KEY=
MODELO=claude-opus-5
# low | medium | high | xhigh | max. Mas esfuerzo = mejor razonamiento y mas
# coste. `high` va bien para casa; sube a `xhigh` para optimizacion energetica.
ESFUERZO=high

# --- Home Assistant (frontal de la domotica ONNA/KNX) ----------------------
# El token se crea en HA: perfil de usuario -> Tokens de acceso de larga duracion
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Bus KNX directo (sistema ONNA) ---------------------------------------
# Solo si necesitas direcciones que HA no expone. IP del servidor ONNA o de un
# router KNX/IP. Deja KNX_HABILITADO=false si vas solo por Home Assistant.
KNX_HABILITADO=false
KNX_GATEWAY_IP=
KNX_GATEWAY_PUERTO=3671
# true si el backend corre en Docker con red bridge
KNX_ROUTE_BACK=true

# --- Energia: de donde se leen solar y bateria -----------------------------
# auto          -> Modbus si hay SUNGROW_HOST, si no los sensores de HA
# modbus        -> solo Modbus directo (exige estar en la red del inversor)
# homeassistant -> solo sensores de HA (funciona desde fuera de casa, y
#                  convive con HA leyendo el inversor). Requiere la seccion
#                  `energia_ha:` en config/config.yaml. Ver docs/DESPLIEGUE.md
ENERGIA_ORIGEN=auto

# Gestion del excedente solar (herramienta excedente_solar).
# La potencia que entra en la bateria solo cuenta como excedente redirigible
# cuando la bateria esta por encima de este porcentaje: antes de eso, cargarla
# es mejor uso que encender un aparato.
EXCEDENTE_SOC_MINIMO=90
# Vatios que se dejan sin usar, para no pasar a importar por una nube o un pico.
EXCEDENTE_MARGEN_W=300

# --- Inversor Sungrow ------------------------------------------------------
# IP del dongle WiNet-S o del inversor. Ojo: el WiNet-S solo admite UNA
# conexion Modbus a la vez. Si Home Assistant ya la usa, este cliente no entra.
SUNGROW_HOST=
SUNGROW_PUERTO=502
SUNGROW_SLAVE_ID=1
# Tope duro de potencia que el agente puede ordenar a la bateria (vatios)
SUNGROW_MAX_POTENCIA_W=5000
# Ponlo en true si `python -m casa_ai.verificar` te dice que lo hagas
SUNGROW_INVERTIR_SIGNO_RED=false

# --- UniFi (red y camaras) -------------------------------------------------
# Usa una cuenta LOCAL del controlador, no la cuenta de ui.com
UNIFI_HOST=192.168.1.1
UNIFI_PUERTO=443
UNIFI_USUARIO=
UNIFI_PASSWORD=
UNIFI_SITE=default
# Por este canal viajan las credenciales del administrador local de UniFi, asi
# que la verificacion esta ACTIVADA por defecto. Las consolas traen
# certificado autofirmado: exporta el suyo y apuntalo aqui en vez de
# desactivar la verificacion.
UNIFI_VERIFICAR_TLS=true
UNIFI_CA_BUNDLE=

# --- Telegram --------------------------------------------------------------
# Token de @BotFather. Los chat_id autorizados, separados por comas: escribele
# al bot y mira los logs, te dira tu chat_id. Vacio = el bot no atiende a nadie.
TELEGRAM_TOKEN=
TELEGRAM_CHATS_AUTORIZADOS=

# --- WhatsApp Cloud API (opcional) -----------------------------------------
# Necesita webhook publico por HTTPS (Cloudflare Tunnel o similar).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# OBLIGATORIO si usas WhatsApp: el secreto de la app en Meta for Developers
# (App -> Configuracion -> Basica -> Clave secreta de la app). Sin el no se
# puede comprobar que la entrega venga de Meta, y el numero del remitente
# viaja en el cuerpo de la peticion: cualquiera podria hacerse pasar por ti.
WHATSAPP_APP_SECRET=
# Numeros en formato internacional sin +, separados por comas
WHATSAPP_NUMEROS_AUTORIZADOS=

# --- Transcripcion de voz (local, no sale de casa) -------------------------
# tiny | base | small | medium | large-v3. `small` va bien en CPU.
WHISPER_MODELO=small
WHISPER_DISPOSITIVO=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Seguridad del canal HTTP ----------------------------------------------
# OBLIGATORIO para usar el API HTTP. Sin token, los endpoints devuelven 503:
# este canal da el mismo control de la casa que Telegram, asi que abrirlo sin
# autenticacion no es una opcion. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Por defecto solo escucha en localhost. Si lo pones a 0.0.0.0 para alcanzarlo
# desde otro equipo de la red, el token pasa a ser imprescindible.
API_HOST=127.0.0.1
API_PUERTO=8099

# --- Operacion -------------------------------------------------------------
LOG_LEVEL=INFO
ZONA_HORARIA=Europe/Madrid
# Ponlo en false SOLO si sabes lo que haces: desactiva la confirmacion humana
# de las acciones de riesgo (bateria, wifi, bus KNX crudo).
EXIGIR_CONFIRMACION=true
